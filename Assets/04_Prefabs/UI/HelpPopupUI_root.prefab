    \uC783\uC5B4\uAC00\uACE0 \uC788\uC5C8\uB2E4.\n\n\uD50C\uB808\uC774\uC5B4\uB294
    \uBAA8\uB4E0 \uAC83\uC744 \uC783\uACE0 \uC8FD\uC74C\uC758 \uC21C\uAC04\uC5D0
    \uB2E4\uB2E4\uB978 \uD55C \uC804\uC0AC.\n\uADF8\uB7EC\uB098 \uB9C8\uC9C0\uB9C9
    \uC21C\uAC04, \uC54C \uC218 \uC5C6\uB294 \uD798\uC5D0 \uC758\uD574 \n\uC8FD\uC74C
    \uC774\uC804\uC758 \uC2DC\uAC04\uC73C\uB85C \uB418\uB3CC\uC544\uC624\uB294 \u2018\uD68C\uADC0\u2019\uC758
    \uAE30\uC5F0\uC744 \uC5BB\uAC8C \uB41C\uB2E4.\n\n\uB208\uC744 \uB72C \uACF3\uC740
    \uBAAC\uC2A4\uD130\uB4E4\uC5D0\uAC8C \uC810\uB839\uB2F9\uD55C \uD669\uD3D0\uD55C
    \uB9C8\uC744\uC758 \uC785\uAD6C.\n\uC0AC\uB78C\uB4E4\uC740 \uACF5\uD3EC\uC5D0
    \uB5A8\uACE0 \uC788\uACE0, \uC0B4\uC544\uB0A8\uC740 \uC790\uB4E4\uC740 \uC791\uC740
    \uB9C8\uC744\uC5D0 \uBAB8\uC744 \uC228\uAE34 \uCC44 \uD558\uB8E8\uD558\uB8E8\uB97C
    \uBC84\uD2F0\uACE0 \uC788\uB2E4.\n\n\uD50C\uB808\uC774\uC5B4\uB294 \uBC18\uBCF5\uB418\uB294
    \uC8FD\uC74C\uACFC \uD658\uC0DD \uC18D\uC5D0\uC11C \uAE30\uC5B5\uACFC \uD798\uC744
    \uCD95\uC801\uD558\uBA70 \uC131\uC7A5\uD558\uAC8C \uB41C\uB2E4.\n\uCC98\uC74C\uC5D0\uB294
    \uC808\uB300 \uC774\uAE38 \uC218 \uC5C6\uC5C8\uB358 \uBAAC\uC2A4\uD130\uC640
    \uBCF4\uC2A4\uB4E4\uB3C4, \uBC18\uBCF5\uB418\uB294 \uC804\uD22C\uC640 \uC7A5\uBE44
    \uC218\uC9D1, \uC2A4\uD0AC \uAC15\uD654, \uADF8\uB9AC\uACE0 \uC218\uB9CE\uC740
    \uC2E4\uD328\uB97C \uD1B5\uD574\n \uC870\uAE08\uC529 \uACF5\uB7B5\uD560 \uC218
    \uC788\uAC8C \uB41C\uB2E4.\n\n\uB9C8\uC744\uC758 \uC0AC\uB78C\uB4E4\uACFC \uD611\uB825\uD558\uBA70
    \uD018\uC2A4\uD2B8\uB97C \uC218\uD589\uD558\uACE0, \uC228\uACA8\uC9C4 \uC9C4\uC2E4\uACFC
    \uC138\uACC4\uC758 \uBD95\uAD34 \uC6D0\uC778\uC744 \uCD94\uC801\uD558\uB358 \uD50C\uB808\uC774\uC5B4\uB294
    \uACB0\uAD6D \uC138\uACC4\uC758 \uB05D\uC5D0\uC11C \uBAA8\uB4E0 \uC7AC\uC559\uC758
    \uADFC\uC6D0\uACFC \uB9C8\uC8FC\uD558\uAC8C \uB41C\uB2E4.\n\n\u201C\uC8FD\uC74C\uC740
    \uB05D\uC774 \uC544\uB2C8\uB2E4.\n\uBC18\uBCF5\uB418\uB294 \uC724\uD68C \uC18D\uC5D0\uC11C,
    \uB354\uC6B1 \uAC15\uD574\uC838\uB77C.\u201D\n\n\uB05D\uC5C6\uB294 \uD68C\uADC0\uC758
    \uB05D\uC5D0\uC11C \uCD5C\uD6C4\uC758 \uBAAC\uC2A4\uD130\uB97C \uC4F0\uB7EC\uB728\uB9AC\uACE0\n
    \uC138\uACC4\uB97C \uAD6C\uC6D0\uD558\uB77C."
  m_isRightToLeft: 0
